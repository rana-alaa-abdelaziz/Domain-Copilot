# Database & Vector Store
DATABASE_URL=postgresql://user:password@localhost:5432/domain_copilot
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/domain_copilot_test

# LLM Provider Selection (openai | ollama | nvidia | gemini)
LLM_PROVIDER=openai

# OpenAI Provider Config
OPENAI_API_KEY=

# Gemini Provider Config
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# NVIDIA NIM Provider Config
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
# Keep Ollama embeddings by default: the database uses 768 dimensions.
NVIDIA_EMBEDDING_PROVIDER=ollama
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# Ollama / Local Provider Config
OLLAMA_BASE_URL=http://ollama:11434

# App Settings
# A real deployment MUST set this to a strong, random value for JWT signing
SECRET_KEY=

# APP_ENV=development enables an auto-generated JWT secret for local
# dev convenience. Set to "production" (or anything else) before any
# real deployment — the app will then refuse to start without a real
# SECRET_KEY, rather than silently using an insecure default.
APP_ENV=development
LOG_LEVEL=INFO

# Allowed origins for CORS (comma separated)
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://my-frontend.com
ALLOWED_ORIGINS=