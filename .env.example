# Database & Vector Store
DATABASE_URL=postgresql://user:password@localhost:5432/domain_copilot
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/domain_copilot_test

# LLM Provider Selection (openai | ollama)
LLM_PROVIDER=openai

# OpenAI Provider Config
OPENAI_API_KEY=

# Ollama / Local Provider Config
OLLAMA_BASE_URL=http://localhost:11434

# App Settings
# A real deployment MUST set this to a strong, random value for JWT signing
SECRET_KEY=

# APP_ENV=development enables an auto-generated JWT secret for local
# dev convenience. Set to "production" (or anything else) before any
# real deployment — the app will then refuse to start without a real
# SECRET_KEY, rather than silently using an insecure default.
APP_ENV=development
LOG_LEVEL=INFO